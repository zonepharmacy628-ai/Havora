# ─────────────────────────────────────────────────────────────────────────────
# HAVORA environment variables — copy to `.env` and fill in real values.
# Never commit `.env`. Every value below is a placeholder.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL. DATABASE_URL is used by the app (use the *pooled* URL in production);
# DIRECT_URL is used by Prisma Migrate (use the *direct / unpooled* URL).
# Local development with `npm run db:local` uses the same URL for both.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"

# Authentication. Generate a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Public base URL of the site (no trailing slash). In production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Administrator. The one account with this email address is granted administrator
# rights at the end of each deployment (it must already be registered on the site).
# Leave empty to change nothing. There is no public administrator registration.
ADMIN_EMAIL=""

# Seed script (`npm run db:seed`). The admin account is created from these values.
# Demo owner/customer accounts share SEED_DEMO_PASSWORD. Use strong values (10+ characters).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_DEMO_PASSWORD="replace-with-a-strong-password"

# Transactional email (password reset). Optional: without it, reset links are
# written to the server log instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="HAVORA <no-reply@your-domain.com>"

# Cloudinary (owner photo uploads). Optional: without it, owners add photos by URL.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
